.log-line {
    height: auto;
    flex-direction: row;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    justify-content: center;
    overflow: hidden;
    visibility: visible;
    -unity-text-align: upper-left;
    align-items: center;
    margin-bottom: 1px;
    max-height: 60px;
}

.log-line-icon {
    width: 20px;
    height: 20px;
    background-image: url('project://database/Packages/com.unity.timeline/Editor/StyleSheets/Images/Shared/TimelineWarning.png?fileID=2800000&guid=1732e542f535d374bbfa7565fc78414e&type=3#TimelineWarning');
    flex-grow: 0;
    margin-right: 10px;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 1px;
    margin-left: 5px;
}

.log-line-message {
    width: auto;
    -unity-text-align: upper-left;
    white-space: normal;
    text-overflow: ellipsis;
    flex-grow: 1;
    flex-shrink: 1;
    -unity-font-style: normal;
    align-self: auto;
    align-items: stretch;
    flex-direction: column;
    flex-wrap: wrap;
    overflow: hidden;
    padding-right: 10px;
}

.log-line-collapsed-count-container {
    width: 24px;
    height: 20px;
    background-color: rgb(79, 79, 79);
    -unity-slice-left: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    -unity-text-align: upper-left;
    display: flex;
}

.log-line-collapsed-count-label {
    flex-grow: 1;
    -unity-text-align: middle-center;
    font-size: 10px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}
