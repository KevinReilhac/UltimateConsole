.details-text {
    white-space: normal;
    -unity-text-align: upper-left;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
}

.unity-toggle__label {
    min-width: 0;
    flex-grow: 1;
    width: 100%;
}

.log-types-toggle-count-label {
    margin-right: 0;
    margin-left: 0;
    left: 5px;
    margin-top: 0;
    margin-bottom: 0;
    -unity-text-align: middle-left;
    align-self: center;
    position: absolute;
}

.log-types-toggle-icon {
    overflow: hidden;
    align-self: center;
    margin-right: 0;
    -unity-text-align: upper-left;
    flex-grow: 1;
    height: 13px;
    width: 13px;
    position: absolute;
    right: 2px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.log-types-toggle {
    width: 50px;
    flex-direction: row;
    justify-content: center;
    padding-right: 0;
    padding-left: 0;
    padding-top: 0;
    padding-bottom: 0;
}

#LogLineContainer .log-line-selected {
    background-color: rgba(28, 76, 154, 0.38);
}

#LogLineContainer VisualElement#Line {
    background-color: rgba(0, 0, 0, 0.38);
}

.click-cursor {
}

.log-types-toggles {
    flex-grow: 0;
    flex-direction: row;
}

#ChanelsDropdown {
    min-width: 200px;
}
